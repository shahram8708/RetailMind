# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-random-64-char-secret-key-change-in-production

# Database
DATABASE_URL=sqlite:///retailmind.db

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key-from-google-ai-studio

# Razorpay Payment Gateway (Indian Rupees only)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Email (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=noreply@retailmind.ai

# Elasticsearch (Optional - SQLite fallback used if not configured)
ES_CLOUD_ID=your-elasticsearch-cloud-id
ES_API_KEY=your-elasticsearch-api-key

# Application
BASE_URL=http://localhost:5000
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# PWA
PWA_CACHE_VERSION=1.0.0
BACKGROUND_SYNC_ENABLED=True

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@retailmind.ai
